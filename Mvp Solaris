<!-- JAVASCRIPT DO CARROSSEL -->

<script>

/*
========================================
DICIONÁRIO / LISTA DE IMAGENS
========================================
*/

const imagens = [

"images (1).jpg",

"images (3).jpg",

"images (2).jpg"

];


/*
========================================
IMAGEM ATUAL
========================================
*/

let imagemAtual = 0;


/*
========================================
PEGA A IMAGEM DO CARROSSEL
========================================
*/

const imagemCarrossel =
document.getElementById("imagem-carrossel");


/*
========================================
FUNÇÃO PARA TROCAR A IMAGEM
========================================
*/

function passarImagem(){

imagemCarrossel.style.opacity = "0";


setTimeout(function(){

imagemAtual++;


/*
Se chegar na última imagem,
volta para a primeira
*/

if(imagemAtual >= imagens.length){

imagemAtual = 0;

}


/*
Troca a imagem
*/

imagemCarrossel.src = imagens[imagemAtual];


/*
Faz a nova imagem aparecer
*/

imagemCarrossel.style.opacity = "1";

},500);

}


/*
========================================
TROCA AUTOMÁTICA
========================================
*/

setInterval(passarImagem,3000);

</script>


